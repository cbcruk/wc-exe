{
  "_": "Assertions only this project can make. The harness's generic checks run either way; see verify() in poc/vite-build-intercept/run.mjs.",
  "cssMarker": "#213547",
  "jsMarker": "count is",
  "renderedText": "Sample Exports App",
  "fontFamily": "Inter|system-ui",
  "counter": {
    "selector": "#counter",
    "before": "count is 0",
    "after": "count is 1"
  },
  "mustContain": [
    "BROWSER_STRING_OK",
    "BROWSER_MAP_OK",
    "SUBPATH_IMPORTS_OK",
    "DEEP_EXPORTS_OK"
  ],
  "mustNotContain": [
    "BROWSER_STRING_WRONG_NODE",
    "BROWSER_MAP_WRONG_NODE",
    "SUBPATH_IMPORTS_WRONG_NODE"
  ]
}
